#!/data/data/com.termux/files/usr/bin/sh

BASE="$HOME/moonlight-mux"
LOG="$BASE/logs/boot.log"
mkdir -p "$BASE/logs"

echo "================================" >> "$LOG"
echo "BOOT: $(date)" >> "$LOG"

if command -v termux-wake-lock >/dev/null 2>&1; then
  termux-wake-lock
  echo "Wake lock enabled" >> "$LOG"
fi

sleep 10
"$BASE/mux.sh" start >> "$LOG" 2>&1
echo "MUX start result: $?" >> "$LOG"
